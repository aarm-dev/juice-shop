{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aarm-dev-juice-shop",
	"main": "cloudflare/worker.ts",
	"compatibility_date": "2026-10-14",
	"observability": { "enabled": true },
	"containers": [
		{
			"class_name": "JuiceShop",
			"scheduling_policy": "durable_object",
			"images": {
				"app": {
					"dockerfile": "./Dockerfile",
					"build_context": "."
				}
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "JUICE_SHOP", "class_name": "JuiceShop" }
		]
	},
	"exports": {
		"JuiceShop": { "type": "durable-object", "storage": "sqlite" }
	}
}
